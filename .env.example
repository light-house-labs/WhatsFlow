# Leave DATABASE_URL empty to use the embedded PGlite database in .data/pglite
DATABASE_URL=
# 32+ random characters. Encrypts WhatsApp access tokens at rest.
ENCRYPTION_KEY=
# Public URL of this app (used in webhook instructions and invite links)
APP_URL=http://localhost:3000
# Meta app secret, used to verify X-Hub-Signature-256 on WhatsApp webhooks
META_APP_SECRET=
# Graph API version for the WhatsApp Cloud API
META_GRAPH_VERSION=v23.0
# Bearer token Vercel Cron sends to /api/cron/tick
CRON_SECRET=
SUPPORT_WHATSAPP=
JOBS_INLINE=1
RESEND_API_KEY=
MAIL_FROM="WhatsFlow <no-reply@yourdomain.com>"

# Meta Embedded Signup (needs your app approved as a Tech Provider). Shows "Connect with Facebook".
META_APP_ID=
META_ES_CONFIG_ID=

# AI replies (Settings → AI replies). Optional model override.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Uploads go to Vercel Blob when set, otherwise to .data/uploads on disk.
BLOB_READ_WRITE_TOKEN=

# Allow the test checkout page for payment links in production (normally off).
PAYMENTS_SANDBOX=
# Developer API requests per key per minute
API_RATE_PER_MINUTE=120
